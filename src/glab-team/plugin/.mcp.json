{
  "mcpServers": {
    "messaging": {
      "command": "node",
      "args": ["--use-system-ca", "${CLAUDE_PLUGIN_ROOT}/runtime/channel/plugin-main.mjs"],
      "env": {
        "TM_BROKER_URL": "${user_config.messaging_broker_url}",
        "TM_TOKEN_FILE": "${user_config.messaging_token_file}",
        "TM_MODE": "${user_config.messaging_mode}",
        "TM_ARM": "${user_config.messaging_arm}"
      }
    }
  }
}
